---
interface Props {
  title: string;
  ctaLink?: string;
  ctaText?: string;
}
const { title, ctaLink, ctaText } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<section class="section-block">
  <h2 class="section-title">{title}</h2>
  <slot />
  {ctaLink && ctaText && (
    <p class="section-cta">
      <a href={ctaLink}>{ctaText} →</a>
    </p>
  )}
</section>
<style>
  .section-block {
    margin-bottom: var(--space-xl);
  }
  .section-title {
    font-size: 1.5rem;
    margin-bottom: var(--space-md);
    color: var(--color-accent);
  }
  .section-cta {
    margin-top: var(--space-sm);
  }
  .section-cta a {
    color: var(--color-accent);
  }
</style>
