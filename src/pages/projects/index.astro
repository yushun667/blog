---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;
const projects = (await getCollection('projects')).sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
---
<BaseLayout>
  <Fragment slot="head">
    <title>项目 - 个人网站</title>
  </Fragment>
  <div class="page">
    <h1 class="page-title">项目</h1>
    <div class="card-grid">
      {projects.map((entry) => (
        <Card title={entry.data.title} description={entry.data.description} href={`${base}projects/${entry.id}/`} />
      ))}
    </div>
  </div>
</BaseLayout>
<style>
  .page {
    padding: var(--space-2xl) var(--space-lg);
    max-width: 56rem;
    margin: 0 auto;
  }
  .page-title {
    font-size: var(--text-h1);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-lg);
    padding-bottom: var(--space-sm);
    border-bottom: 2px solid var(--color-accent-line);
    display: inline-block;
  }
  .card-grid {
    display: grid;
    gap: var(--space-md);
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
  }
</style>
