---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionBlock from '../components/SectionBlock.astro';
import Card from '../components/Card.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;
const projects = (await getCollection('projects')).sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99)).slice(0, 3);
const works = (await getCollection('works')).sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99)).slice(0, 3);
const blogPosts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);
---
<BaseLayout>
  <Fragment slot="head">
    <title>个人网站</title>
  </Fragment>
  <div class="home">
    <header class="hero">
      <h1 class="hero-title">个人网站</h1>
      <p class="hero-tagline">项目展示 · 作品集 · 技术博客</p>
      <div class="hero-line" aria-hidden="true"></div>
    </header>
    <SectionBlock title="项目" ctaLink={`${base}projects/`} ctaText="查看全部">
      <div class="card-grid">
        {projects.map((entry) => (
          <Card title={entry.data.title} description={entry.data.description} href={`${base}projects/${entry.id}/`} />
        ))}
      </div>
    </SectionBlock>
    <SectionBlock title="作品" ctaLink={`${base}works/`} ctaText="查看全部">
      <div class="card-grid">
        {works.map((entry) => (
          <Card title={entry.data.title} description={entry.data.description} href={`${base}works/${entry.id}/`} />
        ))}
      </div>
    </SectionBlock>
    <SectionBlock title="博客" ctaLink={`${base}blog/`} ctaText="查看全部">
      <div class="card-grid">
        {blogPosts.map((entry) => (
          <Card title={entry.data.title} description={entry.data.description} href={`${base}blog/${entry.id}/`} />
        ))}
      </div>
    </SectionBlock>
  </div>
</BaseLayout>
<style>
  .home {
    padding: var(--space-xl) var(--space-md);
    max-width: var(--content-max);
    margin: 0 auto;
  }
  .hero {
    margin-bottom: var(--space-xl);
    animation: fadeInUp 0.6s ease both;
  }
  .hero-title {
    font-size: clamp(2rem, 4.5vw, var(--text-display));
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: var(--space-xs);
    color: var(--color-text);
  }
  .hero-tagline {
    font-size: var(--text-body);
    color: var(--color-text-muted);
    letter-spacing: 0.04em;
    margin-bottom: var(--space-sm);
  }
  .hero-line {
    width: 3rem;
    height: 4px;
    background: linear-gradient(90deg, var(--color-accent), transparent);
    border-radius: 2px;
    animation: fadeInUp 0.6s ease 0.15s both;
  }
  .card-grid {
    display: grid;
    gap: var(--space-sm);
    grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
  }
  .section-block {
    animation: fadeInUp 0.55s ease both;
    margin-bottom: var(--space-xl);
  }
  .section-block:last-of-type {
    margin-bottom: 0;
  }
  .section-block:nth-of-type(1) { animation-delay: 0.08s; }
  .section-block:nth-of-type(2) { animation-delay: 0.18s; }
  .section-block:nth-of-type(3) { animation-delay: 0.28s; }
  .section-block:nth-of-type(4) { animation-delay: 0.38s; }
</style>
