---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionBlock from '../components/SectionBlock.astro';
import Card from '../components/Card.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;
const projects = (await getCollection('projects')).sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99)).slice(0, 3);
const works = (await getCollection('works')).sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99)).slice(0, 3);
const blogPosts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);
---
<BaseLayout>
  <Fragment slot="head">
    <title>个人网站</title>
  </Fragment>
  <div class="home">
    <div class="intro">
      <h1>个人网站</h1>
      <p class="tagline">项目展示 · 作品集 · 技术博客</p>
    </div>
    <SectionBlock title="项目" ctaLink={`${base}projects/`} ctaText="查看全部">
      <div class="card-grid">
        {projects.map((entry) => (
          <Card title={entry.data.title} description={entry.data.description} href={`${base}projects/${entry.id}/`} />
        ))}
      </div>
    </SectionBlock>
    <SectionBlock title="作品" ctaLink={`${base}works/`} ctaText="查看全部">
      <div class="card-grid">
        {works.map((entry) => (
          <Card title={entry.data.title} description={entry.data.description} href={`${base}works/${entry.id}/`} />
        ))}
      </div>
    </SectionBlock>
    <SectionBlock title="博客" ctaLink={`${base}blog/`} ctaText="查看全部">
      <div class="card-grid">
        {blogPosts.map((entry) => (
          <Card title={entry.data.title} description={entry.data.description} href={`${base}blog/${entry.id}/`} />
        ))}
      </div>
    </SectionBlock>
  </div>
</BaseLayout>
<style>
  .home {
    padding: var(--space-xl) var(--space-md);
    max-width: 56rem;
    margin: 0 auto;
  }
  .intro {
    margin-bottom: var(--space-xl);
  }
  .intro h1 {
    font-size: 2rem;
    margin-bottom: var(--space-xs);
  }
  .tagline {
    color: var(--color-text-muted);
  }
  .card-grid {
    display: grid;
    gap: var(--space-md);
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
  }
</style>
